{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectious.work/schemas/host-gated-release-handover-v1.schema.json",
  "title": "projectious.work host-gated release handover",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "source", "producer", "artifacts", "validation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "toolchain"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "toolchain": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedIdentity" } }
      }
    },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_schema", "mandatory_checks", "conditional_surfaces"],
      "properties": {
        "manifest_schema": { "type": "string", "minLength": 1 },
        "mandatory_checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "conditional_surfaces": { "type": "array", "items": { "$ref": "#/$defs/conditionalSurface" } }
      }
    },
    "metadata": { "type": "object", "description": "Non-locating evidence metadata; producer-local paths are not verifier locators." }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "namedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "conditionalSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["selected", "skipped"] },
        "reason": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string" }
      }
    }
  }
}
