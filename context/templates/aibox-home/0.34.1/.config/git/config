[core]
    editor = vim
    pager = delta
[init]
    defaultBranch = main
[pull]
    rebase = true
[interactive]
    diffFilter = delta --color-only
[delta]
    syntax-theme = aibox
    light = false
    navigate = true
    line-numbers = true
    side-by-side = false
    hunk-header-decoration-style = "#8B949E" box
    file-decoration-style = "#58A6FF" ul
    minus-style = syntax "#411F22"
    minus-emph-style = syntax "#411F22"
    plus-style = syntax "#183624"
    plus-emph-style = syntax "#183624"
    zero-style = syntax "#382F19"
[merge]
    conflictStyle = zdiff3

[include]
    path = ~/.config/git/aibox-github.inc
