#!/usr/bin/env bash
# Generated by aibox — do not edit manually.
#
# Provider-neutral agent attention state for tmux and terminal tabs.
set -u

usage() {
    printf 'usage: aibox-agent-signal [--harness NAME] [--agent MODEL] [--effort LEVEL] [--hook-input] [--task TEXT] [--message TEXT] STATE\n' >&2
}

clean() {
    local limit="${2:-160}"
    printf '%s' "${1:-}" | python3 -c \
        'import sys, unicodedata
limit = int(sys.argv[1])
value = "".join(c for c in sys.stdin.read() if unicodedata.category(c) != "Cc")
print(value[:limit], end="")' "$limit" 2>/dev/null || true
}

format_elapsed() {
    local seconds="${1:-0}"
    if (( seconds < 60 )); then
        printf '%ss' "$seconds"
    elif (( seconds < 3600 )); then
        printf '%sm' "$((seconds / 60))"
    else
        printf '%sh' "$((seconds / 3600))"
    fi
}

repository_from_remote() {
    local repository_root="$1" style="$2" remote_url="" remote_name="" repository=""
    remote_url="$(git -C "$repository_root" config --get remote.origin.url 2>/dev/null || true)"
    if [[ -z "$remote_url" ]]; then
        while IFS= read -r remote_name; do
            [[ -n "$remote_name" ]] || continue
            remote_url="$(git -C "$repository_root" config --get "remote.${remote_name}.url" 2>/dev/null || true)"
            [[ -n "$remote_url" ]] && break
        done < <(git -C "$repository_root" remote 2>/dev/null || true)
    fi

    if [[ "$remote_url" == *://* ]]; then
        repository="${remote_url#*://}"
        repository="${repository#*@}"
        repository="${repository#*/}"
    elif [[ "$remote_url" == *@*:* ]]; then
        repository="${remote_url#*:}"
    fi
    repository="${repository%%\?*}"
    repository="${repository%%#*}"
    repository="${repository#/}"
    repository="${repository%/}"
    repository="${repository%.git}"

    if [[ -z "$repository" ]]; then
        repository="${repository_root##*/}"
    elif [[ "$style" != full ]]; then
        repository="${repository##*/}"
    fi
    clean "$repository" 160
}

codex_thread_model() {
    local thread_id="${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}"
    local working_directory="${1:-}"
    local codex_dir="${CODEX_HOME:-$HOME/.codex}"
    [[ -d "$codex_dir" ]] || return 0
    python3 -c \
        'import glob, os, sqlite3, sys
thread_id, working_directory, codex_dir = sys.argv[1:]
for path in sorted(glob.glob(os.path.join(codex_dir, "state_*.sqlite")), reverse=True):
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        row = None
        if thread_id:
            row = db.execute(
                "select model, reasoning_effort from threads where id = ?", (thread_id,)
            ).fetchone()
        if not row and working_directory:
            row = db.execute(
                "select model, reasoning_effort from threads "
                "where cwd = ? and archived = 0 and model is not null "
                "order by coalesce(updated_at_ms, updated_at * 1000) desc limit 1",
                (working_directory,),
            ).fetchone()
        db.close()
        if row and row[0]:
            print(f"{row[0]}\t{row[1] or str()}", end="")
            break
    except (OSError, sqlite3.Error):
        pass' "$thread_id" "$working_directory" "$codex_dir" 2>/dev/null || true
}

hook_model() {
    python3 -c \
        'import json, os, sys
try:
    payload = json.load(sys.stdin)
except (ValueError, TypeError):
    payload = {}
def scalar(value):
    return value if isinstance(value, str) else ""
def find(obj, names):
    if isinstance(obj, dict):
        for name in names:
            value = obj.get(name)
            if isinstance(value, str) and value:
                return value
            if isinstance(value, dict):
                nested = scalar(value.get("level")) or scalar(value.get("name"))
                if nested:
                    return nested
        for value in obj.values():
            found = find(value, names)
            if found:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find(value, names)
            if found:
                return found
    return ""
model = find(payload, ("model", "model_id", "modelId", "modelID"))
effort = find(payload, ("reasoning_effort", "reasoningEffort", "effort"))
transcript = scalar(payload.get("transcript_path")) or scalar(payload.get("transcriptPath"))
if transcript:
    try:
        with open(transcript, encoding="utf-8") as stream:
            for line in stream:
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                candidate = find(item, ("model", "model_id", "modelId", "modelID"))
                if candidate and candidate != "<synthetic>":
                    model = candidate
                    effort = find(item, ("reasoning_effort", "reasoningEffort", "effort")) or effort
    except OSError:
        pass
print(f"{model}\t{effort}", end="")' 2>/dev/null || true
}

harness_config_model() {
    local harness="$1"
    python3 -c \
        'import json, os, re, sys
harness, home = sys.argv[1:]
paths = {
    "aider": [os.path.join(home, ".aider.conf.yml"), os.path.join(home, ".aider", "config.yml")],
    "continue": [os.path.join(home, ".continue", "config.yaml"), os.path.join(home, ".continue", "config.yml")],
    "hermes": [os.path.join(home, ".hermes", "config.yaml")],
    "tau": [os.path.join(home, ".tau", "config.json"), os.path.join(home, ".tau", "config.toml"), os.path.join(home, ".tau", "config.yaml")],
}.get(harness, [])
keys = ("model", "default_model", "defaultModel", "model_id", "modelId")
def find(obj):
    if isinstance(obj, dict):
        for key in keys:
            value = obj.get(key)
            if isinstance(value, str) and value:
                return value
            if isinstance(value, dict):
                for nested in ("default", "name", "id", "model"):
                    if isinstance(value.get(nested), str) and value[nested]:
                        return value[nested]
        for value in obj.values():
            found = find(value)
            if found:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find(value)
            if found:
                return found
    return ""
for path in paths:
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        continue
    if path.endswith(".json"):
        try: value = find(json.loads(text))
        except ValueError: value = ""
    else:
        match = re.search(r"(?m)^\s*(?:model|default_model|default-model)\s*[:=]\s*[\"\x27]?([^\s\"\x27#]+)", text)
        value = match.group(1) if match else ""
    if value:
        print(value, end="")
        break' "$harness" "$HOME" 2>/dev/null || true
}

state=""
target_window=""
harness="${AIBOX_AGENT_HARNESS:-}"
agent="${AIBOX_AGENT_NAME:-}"
effort="${AIBOX_AGENT_REASONING_EFFORT:-${AIBOX_AGENT_EFFORT:-}}"
task="${AIBOX_AGENT_TASK:-}"
message="${AIBOX_AGENT_MESSAGE:-}"
hook_input=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --harness) [[ $# -ge 2 ]] || { usage; exit 2; }; harness="$2"; shift 2 ;;
        --agent|--name) [[ $# -ge 2 ]] || { usage; exit 2; }; agent="$2"; shift 2 ;;
        --effort|--reasoning-effort) [[ $# -ge 2 ]] || { usage; exit 2; }; effort="$2"; shift 2 ;;
        --hook-input) hook_input=1; shift ;;
        --task) [[ $# -ge 2 ]] || { usage; exit 2; }; task="$2"; shift 2 ;;
        --message) [[ $# -ge 2 ]] || { usage; exit 2; }; message="$2"; shift 2 ;;
        --window) [[ $# -ge 2 ]] || { usage; exit 2; }; target_window="$2"; shift 2 ;;
        --state) [[ $# -ge 2 ]] || { usage; exit 2; }; state="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        -*) usage; exit 2 ;;
        *) [[ -z "$state" ]] && state="$1" || { usage; exit 2; }; shift ;;
    esac
done

case "$state" in
    working|question|done|error|idle|clear|refresh) ;;
    *) usage; exit 2 ;;
esac

# Hooks may also run from host IDEs. Attention signaling is always best effort.
if [[ -z "${TMUX:-}" ]] || ! command -v tmux >/dev/null 2>&1; then
    exit 0
fi

pane="${TMUX_PANE:-}"
if [[ "$state" != refresh ]]; then
    if [[ -z "$pane" ]] || ! tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
        exit 0
    fi
    target_window="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
    [[ -n "$target_window" ]] || exit 0

    if [[ "$state" == clear ]]; then
        state="idle"
        message=""
        task=""
    fi

    message_limit="$(tmux show-option -gqv @aibox_title_message_max_length 2>/dev/null || true)"
    [[ "$message_limit" =~ ^[0-9]+$ ]] || message_limit=32
    harness="$(clean "$harness" 160)"
    if [[ -z "$agent" && "$hook_input" == 1 ]]; then
        hook_identity="$(hook_model)"
        if [[ "$hook_identity" == *$'\t'* ]]; then
            agent="${hook_identity%%$'\t'*}"
            [[ -n "$effort" ]] || effort="${hook_identity#*$'\t'}"
        fi
    fi
    if [[ -z "$agent" ]]; then
        agent="$(harness_config_model "$harness")"
    fi
    if [[ -z "$agent" && "$harness" == codex ]]; then
        pane_path="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"
        codex_identity="$(codex_thread_model "$pane_path")"
        if [[ "$codex_identity" == *$'\t'* ]]; then
            agent="${codex_identity%%$'\t'*}"
            [[ -n "$effort" ]] || effort="${codex_identity#*$'\t'}"
        fi
    fi
    if [[ -z "$agent" ]]; then
        agent="$(tmux show-option -pqv -t "$pane" @aibox_attention_agent_model 2>/dev/null || true)"
        [[ -n "$effort" ]] \
            || effort="$(tmux show-option -pqv -t "$pane" @aibox_attention_agent_effort 2>/dev/null || true)"
    fi
    agent="$(clean "$agent" 160)"
    effort="$(clean "$effort" 32)"
    agent_model="$agent"
    agent_style="$(tmux show-option -gqv @aibox_title_agent_style 2>/dev/null || true)"
    if [[ "$agent_style" == full && -n "$agent" && -n "$effort" ]]; then
        agent="$agent $effort"
    fi
    task="$(clean "$task" 160)"
    message="$(clean "$message" "$message_limit")"
    updated="$(date +%s)"

    tmux set-option -p -t "$pane" @aibox_attention_state "$state" 2>/dev/null || exit 0
    tmux set-option -p -t "$pane" @aibox_attention_harness "$harness" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_agent_model "$agent_model" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_agent_effort "$effort" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_agent "$agent" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_task "$task" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_message "$message" 2>/dev/null || true
    tmux set-option -p -t "$pane" @aibox_attention_updated "$updated" 2>/dev/null || true
fi

[[ -n "$target_window" ]] || exit 0
if ! tmux list-panes -t "$target_window" >/dev/null 2>&1; then
    exit 0
fi

done_ttl="$(tmux show-option -gqv @aibox_done_ttl_seconds 2>/dev/null || true)"
[[ "$done_ttl" =~ ^[0-9]+$ ]] || done_ttl=0

aggregate="idle"
aggregate_rank=0
aggregate_message=""
aggregate_harness=""
aggregate_agent=""
aggregate_task=""
aggregate_updated=""
aggregate_path=""
now="$(date +%s)"
while IFS= read -r pane_id; do
    [[ -n "$pane_id" ]] || continue
    # Query each field independently. tmux format output has no escaping mode,
    # so delimiter-based parsing would corrupt empty fields or values that
    # legitimately contain the chosen delimiter.
    pane_path="$(tmux display-message -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null || true)"
    pane_state="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_state 2>/dev/null || true)"
    pane_harness="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_harness 2>/dev/null || true)"
    pane_agent="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_agent 2>/dev/null || true)"
    pane_task="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_task 2>/dev/null || true)"
    pane_message="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_message 2>/dev/null || true)"
    pane_updated="$(tmux show-option -pqv -t "$pane_id" @aibox_attention_updated 2>/dev/null || true)"
    if [[ "$pane_state" == done && "$done_ttl" != 0 && "$pane_updated" =~ ^[0-9]+$ ]] \
        && (( now - pane_updated >= done_ttl )); then
        tmux set-option -p -t "$pane_id" @aibox_attention_state idle 2>/dev/null || true
        pane_state="idle"
        pane_message=""
    fi
    case "$pane_state" in
        error) rank=4 ;; question) rank=3 ;; working) rank=2 ;; done) rank=1 ;;
        *) rank=0; pane_state="idle" ;;
    esac
    # Select one idle pane as the metadata source too. Otherwise an all-idle
    # window loses its repository, harness, and agent even though the panes
    # still have stable context.
    if (( rank > aggregate_rank )) \
        || [[ -z "$aggregate_path" ]] \
        || { (( rank == aggregate_rank )) && [[ -z "$aggregate_harness" && -n "$pane_harness" ]]; }; then
        aggregate_rank=$rank
        aggregate="$pane_state"
        aggregate_harness="$pane_harness"
        aggregate_agent="$pane_agent"
        aggregate_task="$pane_task"
        aggregate_message="$pane_message"
        aggregate_updated="$pane_updated"
        aggregate_path="$pane_path"
    fi
done < <(tmux list-panes -t "$target_window" -F '#{pane_id}' 2>/dev/null || true)

previous="$(tmux show-window-option -v -t "$target_window" @aibox_attention_state 2>/dev/null || true)"
symbol="$(tmux show-option -gqv "@aibox_title_state_${aggregate}" 2>/dev/null || true)"
repository=""
branch=""
if [[ -n "$aggregate_path" ]] && command -v git >/dev/null 2>&1; then
    repository_root="$(git -C "$aggregate_path" rev-parse --show-toplevel 2>/dev/null || true)"
    repository_style="$(tmux show-option -gqv @aibox_title_repository_style 2>/dev/null || true)"
    [[ "$repository_style" == full ]] || repository_style="basename"
    [[ -n "$repository_root" ]] && repository="$(repository_from_remote "$repository_root" "$repository_style")"
    branch="$(git -C "$aggregate_path" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$aggregate_path" rev-parse --short HEAD 2>/dev/null || true)"
    branch="$(clean "$branch" 80)"
fi
elapsed=""
if [[ "$aggregate_updated" =~ ^[0-9]+$ ]]; then
    elapsed="$(format_elapsed "$((now - aggregate_updated))")"
fi

tmux set-window-option -t "$target_window" @aibox_attention_state "$aggregate" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_symbol "$symbol" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_harness "$aggregate_harness" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_agent "$aggregate_agent" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_task "$aggregate_task" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_message "$aggregate_message" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_repository "$repository" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_branch "$branch" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_elapsed "$elapsed" 2>/dev/null || true
tmux set-window-option -t "$target_window" @aibox_attention_updated "$aggregate_updated" 2>/dev/null || true

# Schedule a timestamp-guarded refresh so `done` expires without another event.
if [[ "$state" == done && "$done_ttl" != 0 && -n "$pane" ]]; then
    self="${BASH_SOURCE[0]}"
    printf -v timer 'sleep %q; current=$(tmux show-option -p -v -t %q @aibox_attention_state 2>/dev/null || true); updated=$(tmux show-option -p -v -t %q @aibox_attention_updated 2>/dev/null || true); if [ "$current" = done ] && [ "$updated" = %q ]; then tmux set-option -p -t %q @aibox_attention_state idle 2>/dev/null || true; %q refresh --window %q; fi' \
        "$done_ttl" "$pane" "$pane" "$updated" "$pane" "$self" "$target_window"
    tmux run-shell -b "$timer" 2>/dev/null || true
fi

# Terminal attention notifications are opt-in and transition-only. Hooks
# normally have no controlling terminal, so write to each attached tmux
# client's TTY instead of relying on hook stdout or /dev/tty. OSC 9 carries a
# message on supporting terminals; bell is the portable attention fallback.
notify_enabled="$(tmux show-option -gqv @aibox_notifications_enabled 2>/dev/null || true)"
notify_states=",$(tmux show-option -gqv @aibox_notification_states 2>/dev/null || true),"
if [[ "$notify_enabled" == 1 && "$previous" != "$aggregate" \
      && "$notify_states" == *",$aggregate,"* ]]; then
    note="$aggregate"
    include_message="$(tmux show-option -gqv @aibox_notifications_include_message 2>/dev/null || true)"
    [[ "$include_message" == 1 && -n "$aggregate_message" ]] && note="$note: $aggregate_message"
    notify_protocol="$(tmux show-option -gqv @aibox_notifications_protocol 2>/dev/null || true)"
    while IFS= read -r client_tty; do
        [[ "$client_tty" == /dev/* && -w "$client_tty" ]] || continue
        if [[ "$notify_protocol" == bell ]]; then
            printf '\a' >"$client_tty" 2>/dev/null || true
        else
            printf '\033Ptmux;\033\033]9;%s\a\033\\' "$(clean "$note" 200)" >"$client_tty" 2>/dev/null || true
        fi
    done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null || true)
fi

# Refresh every attached client, not only the status line. Lifecycle hooks run
# through `run-shell` and may not retain a current-client association. An
# untargeted refresh can therefore succeed without repainting the Ghostty (or
# other host terminal) title that owns this session. The attention state is
# part of set-titles-string, so target each attached client explicitly.
while IFS= read -r client_name; do
    [[ -n "$client_name" ]] || continue
    tmux refresh-client -t "$client_name" 2>/dev/null || true
done < <(tmux list-clients -F '#{client_name}' 2>/dev/null || true)
exit 0
