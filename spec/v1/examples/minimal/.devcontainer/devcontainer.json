// aibox v1 example: standard Dev Container JSON with Comments (JSONC).
// Uncomment only settings needed by this project; add a comma before the next active key.
// image, build and dockerComposeFile are alternative native definitions.
// aibox does not parse or transform native build/up fields; devcontainer.cli owns them.
// Native options below are limited to aibox journeys; upstream documents all others.
// Optional aibox keys come from spec/v1/customization.schema.json, not a parallel build schema.
// For unconstrained strings, comments state schema-valid types; check runtime support before activation.
// Feature-specific options come from each selected Feature manifest, not this file.
{
  // devcontainer.build: Build from a project Dockerfile instead of image; choose exactly one source. Valid: object.
  // "build": {
    // devcontainer.build.dockerfile: Select the project Dockerfile path relative to this JSONC file. Valid: JSON string; use a value supported by the owning runtime.
    // "dockerfile": "Dockerfile",
    // devcontainer.build.context: Select the native Docker build-context directory. Valid: JSON string; use a value supported by the owning runtime.
    // "context": "..",
  // },
  // devcontainer.dockerComposeFile: Select ordered native Compose files instead of a single-image definition. Valid: relative path or ordered array of relative paths.
  // "dockerComposeFile": ["compose.yaml"],
  // devcontainer.service: Name the primary service when using dockerComposeFile. Valid: JSON string; use a value supported by the owning runtime.
  // "service": "workspace",
  // devcontainer.runServices: Choose Compose services started with the primary service. Valid: array of string.
  // "runServices": ["workspace"],
  // devcontainer.containerUser: Choose the user for all container processes; align its home and mounts. Valid: JSON string; use a value supported by the owning runtime.
  // "containerUser": "vscode",
  // devcontainer.workspaceFolder: Choose the project path opened inside the container. Valid: JSON string; use a value supported by the owning runtime.
  // "workspaceFolder": "/workspaces/project",
  // devcontainer.workspaceMount: Override the project mount; coordinate with workspaceFolder. Valid: JSON string; use a value supported by the owning runtime.
  // "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/project,type=bind",
  // devcontainer.forwardPorts: Forward selected development ports to the client without publishing them. Valid: array of port numbers or "host:port" strings.
  // "forwardPorts": [3000],
  // devcontainer.containerEnv: Set non-secret variables for all container processes; rebuild after changes. Valid: object with named entries.
  // "containerEnv": {"EXAMPLE":"value"},
  // devcontainer.remoteEnv: Set non-secret variables for connected tools and their child processes. Valid: object with named entries.
  // "remoteEnv": {"EXAMPLE":"value"},
  // devcontainer.features: Install selected, pinned Features; their own manifests define valid option keys. Valid: map of selected Feature IDs to their declared option objects.
  // "features": {},
  // devcontainer.initializeCommand: Run a host-side initialization command; requires explicit operator review. Valid: string, argument array or named-command object.
  // "initializeCommand": "echo reviewed-host-command",
  // devcontainer.postCreateCommand: Run a command inside the newly created container. Valid: string, argument array or named-command object.
  // "postCreateCommand": "echo created",
  // devcontainer.postStartCommand: Run a command inside the container after each start. Valid: string, argument array or named-command object.
  // "postStartCommand": "echo started",
  // devcontainer.shutdownAction: Choose what supporting clients stop when they disconnect. Valid: "none" | "stopContainer" | "stopCompose".
  // "shutdownAction": "none",
  // devcontainer.image: Select a base image instead of build or dockerComposeFile; pin a release by digest. Valid: JSON string; use a value supported by the owning runtime.
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  // devcontainer.mounts: Persist the aibox user home with a named volume, or use a reviewed native bind. Valid: array of native mount strings or mount objects.
  "mounts": ["source=native-devcontainer-home-${devcontainerId},target=/home/vscode,type=volume"],
  // devcontainer.name: Give the Dev Container a human-readable display name. Valid: JSON string; use a value supported by the owning runtime.
  "name": "Native Dev Container",
  // devcontainer.remoteUser: Choose the user for terminals and supporting tools. Valid: JSON string; use a value supported by the owning runtime.
  "remoteUser": "vscode"
