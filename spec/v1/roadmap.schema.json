{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/projectious-work/aibox/blob/v1.x-dev/spec/v1/roadmap.schema.json",
  "title": "aibox v1 specification roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "demos"],
  "properties": {
    "schemaVersion": {"const": "aibox.spec-roadmap/v1"},
    "currentFocus": {"type": "string", "pattern": "^V1-[0-9]{2}$"},
    "demos": {"type": "object", "additionalProperties": {"$ref": "#/$defs/demo"}},
    "groups": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "title", "phases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}}
        }}
    }
  },
  "$defs": {
    "demo": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "expect", "mcp"],
      "properties": {
        "run": {"type": "string", "minLength": 1},
        "expect": {"type": "string", "minLength": 1},
        "mcp": {"type": "object", "additionalProperties": false,
          "required": ["tool", "expect"],
          "properties": {
            "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "expect": {"type": "string", "minLength": 16}
          }}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "status", "docs"],
      "properties": {
        "id": {"type": "string", "pattern": "^V1-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "docs": {"type": "string", "minLength": 1},
        "status": {"enum": ["idea", "planned", "in_progress", "done", "shipped", "cancelled"]},
        "implementationCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target": {"type": "string"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "spec": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "issues": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "devNote": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rationale": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["done", "shipped"]}}}, "then": {"required": ["devNote", "evidence", "implementationCommit"]}},
        {"if": {"properties": {"status": {"const": "shipped"}}}, "then": {"required": ["devNote", "release", "evidence", "implementationCommit"]}},
        {"if": {"properties": {"status": {"const": "cancelled"}}}, "then": {"required": ["rationale"]}}
      ]
    }
  }
}
