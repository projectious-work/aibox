              {
                "text": "This dev container includes Hugo, a popular open-source static site generator written in Go, pre-installed and available on the `PATH`."
              }
            ]
          }
        }
      },
      "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
      ]
    }
  },
