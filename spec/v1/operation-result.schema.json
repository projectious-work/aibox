{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/projectious-work/aibox/blob/v1.x-dev/spec/v1/operation-result.schema.json",
  "title": "aibox CLI/MCP core operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "requestId", "actors", "target", "inputDigest", "outcome", "changedResources", "warnings", "evidence"],
  "properties": {
    "schemaVersion": {"const": "aibox.operation-result/v1"},
    "operation": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "actors": {"type": "object", "additionalProperties": false, "required": ["initiator", "executor"],
      "properties": {"initiator": {"type": "string", "minLength": 1}, "executor": {"type": "string", "minLength": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["scope", "workspaceRoot"],
      "properties": {"scope": {"enum": ["local", "operator"]}, "workspaceRoot": {"type": "string", "minLength": 1},
        "runtimeContext": {"type": "string", "minLength": 1}, "resourceId": {"type": "string", "minLength": 1}},
      "allOf": [{"if": {"properties": {"scope": {"const": "operator"}}}, "then": {"required": ["runtimeContext", "resourceId"]}}]},
    "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["succeeded", "no_change", "failed", "cancelled", "partial", "rebuild_required"]},
    "changedResources": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "category", "message", "nextAction"],
      "properties": {"code": {"type": "string", "minLength": 1},
        "category": {"enum": ["invalid_input", "denied", "missing_dependency", "incompatible", "timeout", "interrupted", "child_failure", "partial_failure", "internal"]},
        "message": {"type": "string", "minLength": 1}, "nextAction": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "failed"}}}, "then": {"required": ["error"]}},
    {"if": {"properties": {"outcome": {"const": "partial"}}}, "then": {"required": ["error"]}}
  ]
}
