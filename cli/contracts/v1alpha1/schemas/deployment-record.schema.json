{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibox.projectious.work/contracts/v1alpha1/deployment-record.schema.json",
  "title": "DeploymentRecord v1alpha1", "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "aibox.projectious.work/v1alpha1" }, "kind": { "const": "DeploymentRecord" }, "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "type": "object", "additionalProperties": false, "required": ["deploymentId", "target", "desiredSpecDigest", "image", "ownership", "status"], "properties": { "deploymentId": { "type": "string" }, "target": { "$ref": "#/$defs/target" }, "desiredSpecDigest": { "type": "string", "pattern": "^sha256:" }, "image": { "$ref": "#/$defs/image" }, "ownership": { "$ref": "#/$defs/ownership" }, "status": { "enum": ["desired", "observed", "degraded", "unavailable", "orphaned", "destroyed"] }, "services": { "type": "array" }, "connections": { "type": "array" }, "processkitResult": { "$ref": "#/$defs/provenance" } } }
  },
  "$defs": {
    "metadata": { "type": "object", "additionalProperties": false, "required": ["name", "owner"], "properties": { "name": { "type": "string" }, "owner": { "type": "object", "additionalProperties": false, "required": ["ownerId"], "properties": { "ownerId": { "type": "string" } } }, "labels": { "type": "object", "additionalProperties": { "type": "string" } } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["backend", "targetRef", "scope"], "properties": { "backend": { "enum": ["compose", "kubernetes"] }, "targetRef": { "type": "string" }, "scope": { "type": "string" } } },
    "image": { "type": "object", "additionalProperties": false, "required": ["reference", "digest"], "properties": { "reference": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:" } } },
    "ownership": { "type": "object", "additionalProperties": false, "required": ["deploymentIdLabel", "desiredSpecDigestLabel", "imageDigestLabel"], "properties": { "deploymentIdLabel": { "type": "string" }, "desiredSpecDigestLabel": { "type": "string" }, "imageDigestLabel": { "type": "string" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["reference", "digest"], "properties": { "reference": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:" } } }
  }
}
