{{ header }}#
# =============================================================================
# HOW TO CUSTOMIZE:
#   Do NOT edit this file directly — it is regenerated by `aibox apply`.
#   To add ports/volumes/env vars: use docker-compose.override.yml
#   To change user:     set user in aibox.toml [container], run `aibox apply`
#
# VOLUME MOUNT STRATEGY:
#   Config files (vim, tmux, yazi, git, AI tools) are mounted read-write from
#   the host-side .aibox-home/ directory so changes persist across rebuilds.
#   The workspace (project root) is mounted at /workspace inside the container.
#   SSH keys are mounted read-only for security.
# =============================================================================
#
name: {{ project_name }}

services:
  {{ name }}:
    build:
      context: .
      dockerfile: {{ dockerfile_path }}
    image: {{ image_name }}
    container_name: {{ name }}
    hostname: {{ hostname }}
    init: true
{% if codex_sandbox_seccomp %}
    # Codex CLI uses bubblewrap for Linux sandboxing. Some container
    # runtime seccomp profiles block unprivileged user namespace creation
    # before bubblewrap can set up its own sandbox. This narrow fallback
    # avoids privileged=true and SYS_ADMIN.
    security_opt:
      - seccomp=unconfined
{% endif %}
    stdin_open: true
    tty: true
    working_dir: /workspace
    volumes:
      # Workspace (project root)
      - ${WORKSPACE_DIR:-{{ workspace_dir }}}:/workspace:rw
{% for mount in runtime_home_mounts %}
      # {{ mount.comment }}
{% if mount.read_only %}
      - {{ mount.source }}:{{ mount.destination }}:ro
{% else %}
      - {{ mount.source }}:{{ mount.destination }}:rw
{% endif %}
{% endfor %}
{% for vol in extra_volumes %}
{% if vol.read_only %}
      - {{ vol.source }}:{{ vol.target }}:ro
{% else %}
      - {{ vol.source }}:{{ vol.target }}:rw
{% endif %}
{% endfor %}
    env_file:
      # Credentials from .aibox-local.toml — gitignored, never committed.
      # Re-generated by `aibox apply`; may be empty when no local overlay exists.
      - {{ local_env_file }}
    environment:
{% for key in env_keys %}
      {{ key }}: "{{ env_vals[key] }}"
{% endfor %}
    command: sleep infinity

{% if latex_preview_enabled %}
  {{ name }}-latex-preview:
    image: {{ image_name }}
    container_name: {{ name }}-latex-preview
    hostname: {{ hostname }}-latex-preview
    user: aibox
    entrypoint: []
    init: true
    working_dir: /workspace
    read_only: true
    pids_limit: 64
    mem_limit: 128m
    cpus: 0.25
    restart: "on-failure:3"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    volumes:
      # The preview can read generated PDFs but cannot mutate the project.
      - ${WORKSPACE_DIR:-{{ workspace_dir }}}:/workspace:ro
    ports:
      # Host exposure is explicit and defaults to loopback only.
      - "{{ latex_preview_publish }}"
    environment:
      AIBOX_LATEX_DOCUMENTS_JSON: "{{ latex_preview_documents_json }}"
      AIBOX_LATEX_PREFERRED_DOCUMENT: "{{ latex_preview_preferred_document }}"
    tmpfs:
      - /tmp:size=16m,mode=1777
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8765/health"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 2s
    command:
      - /usr/local/bin/aibox-latex-preview
      - --bind
      - 0.0.0.0
      - --port
      - "8765"

{% endif %}
  {{ name }}-diagnostics:
    image: {{ image_name }}
    container_name: {{ name }}-diagnostics
    hostname: {{ hostname }}-diagnostics
    user: root
    init: true
    pid: "service:{{ name }}"
    depends_on:
      - {{ name }}
    working_dir: /workspace
    pids_limit: 64
    mem_limit: 64m
    cpus: 0.20
    restart: "on-failure:3"
    volumes:
      # Diagnostics only writes bounded runtime snapshots and event logs.
      # Do not mount the whole workspace here; it makes sidecar disk usage
      # look like a second copy of the project and gives the sidecar a wider
      # write surface than it needs.
      - ${WORKSPACE_DIR:-{{ workspace_dir }}}/.aibox:/workspace/.aibox:rw
    command:
      - /usr/local/bin/aibox-diagnostics
      - --watch
      - --output
      - /workspace/.aibox/diagnostics
