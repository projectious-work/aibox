{
  "id": "claude",
  "version": "1.0.0",
  "name": "claude",
  "description": "Installs claude (aibox catalog ID ai/claude).",
  "documentationURL": "https://code.claude.com/docs/en/setup#install-with-linux-package-managers",
  "options": {
    "version": {
      "type": "string",
      "enum": [
        "2.1.308"
      ],
      "default": "2.1.308",
      "description": "Version of claude to install."
    }
  },
  "containerEnv": {
    "DISABLE_UPDATES": "1"
  }
}
