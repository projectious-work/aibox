# ~/.bashrc — aibox base image shell configuration

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ── Editor ─────────────────────────────────────────────────────────────────
export EDITOR=vim
export VISUAL=vim

# ── History ─────────────────────────────────────────────────────────────────
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# ── Shell options ───────────────────────────────────────────────────────────
shopt -s checkwinsize
shopt -s globstar 2>/dev/null

# ── Aliases (modern replacements) ──────────────────────────────────────────
alias ls='eza --icons'
alias cat='bat --paging=never'
alias find='fd'
alias grep='rg'

# Rustup installs live under ~/.cargo/bin in Rust-enabled containers. VS Code
# terminals and other interactive shells do not always inherit Dockerfile PATH
# updates reliably, so prepend it here as a shell-level fallback.
if [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# ── Theme env (BAT_THEME, FZF_DEFAULT_OPTS, EZA_COLORS, LESS_TERMCAP_*) ────
# Generated by `aibox theme`; sourced before tool integrations so the
# `eval "$(fzf --bash)"` line below picks up the FZF colors.
if [ -r "$HOME/.config/aibox/theme-env.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.config/aibox/theme-env.sh"
fi

# ── Tool integrations ──────────────────────────────────────────────────────
# Starship writes session logs below this path. The runtime cache is bind-mounted
# from `.aibox-home` and can contain user-created files, so repair a file
# collision before Starship initializes instead of printing the same error for
# every shell prompt. `aibox apply` performs the equivalent persistent repair.
if [ -e "$HOME/.cache/starship" ] && [ ! -d "$HOME/.cache/starship" ]; then
    _aibox_starship_backup="$HOME/.cache/starship.aibox-conflict"
    _aibox_starship_suffix=2
    while [ -e "$_aibox_starship_backup" ]; do
        _aibox_starship_backup="$HOME/.cache/starship.aibox-conflict.$_aibox_starship_suffix"
        _aibox_starship_suffix=$((_aibox_starship_suffix + 1))
    done
    mv "$HOME/.cache/starship" "$_aibox_starship_backup"
    printf 'aibox: moved file blocking Starship cache to %s\n' "$_aibox_starship_backup" >&2
fi
mkdir -p "$HOME/.cache/starship"
eval "$(starship init bash)"
eval "$(zoxide init bash)"
eval "$(fzf --bash)"
