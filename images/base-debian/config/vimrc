" =============================================================================
" Vim configuration — programming-focused, no plugins required
" =============================================================================

" ── Basics ────────────────────────────────────────────────────────────────────
set nocompatible            " disable Vi compatibility
set encoding=utf-8
set fileencoding=utf-8
set fileencodings=utf-8,latin1

" ── Appearance ────────────────────────────────────────────────────────────────
syntax on
set background=dark
colorscheme gruvbox          " default aibox theme
set number                   " absolute line numbers
set relativenumber           " relative numbers for fast motion
set cursorline               " highlight current line
set colorcolumn=88           " column guide (PEP8 / Black default)
set signcolumn=yes           " always show sign column (no jitter)
set termguicolors            " 24-bit colour if terminal supports it
set t_u7=                    " avoid terminal query glitches during TUI handoff
set t_RV=                    " avoid version-query glitches during TUI handoff
set laststatus=2             " always show statusline
set ruler                    " show cursor position
set showcmd                  " show partial commands
set showmatch                " highlight matching brackets
set wildmenu                 " enhanced command completion
set wildmode=list:longest,full

" ── Indentation ───────────────────────────────────────────────────────────────
set tabstop=4                " visual width of a tab character
set softtabstop=4            " spaces inserted on <Tab>
set shiftwidth=4             " spaces for auto-indent
set expandtab                " use spaces instead of tabs
set autoindent
set smartindent
filetype plugin indent on    " per-filetype indentation rules

" Override for common file types
autocmd FileType yaml,json,html,css,javascript,typescript,kdl
    \ setlocal tabstop=2 softtabstop=2 shiftwidth=2
autocmd FileType go
    \ setlocal noexpandtab tabstop=4 shiftwidth=4

" ── Search ────────────────────────────────────────────────────────────────────
set incsearch                " incremental search
set hlsearch                 " highlight all matches
set ignorecase               " case-insensitive …
set smartcase                " … unless pattern has uppercase
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

" ── Editor behaviour ──────────────────────────────────────────────────────────
set backspace=indent,eol,start
set hidden                   " allow unsaved background buffers
set scrolloff=8              " keep 8 lines above/below cursor
set sidescrolloff=4
set nowrap                   " keep long lines on one screen row
set sidescroll=1             " horizontal scrolling step
set list                     " show invisible characters
set listchars=tab:→\ ,trail:·,nbsp:␣
set noerrorbells
set visualbell t_vb=         " disable all bells
set mouse=a                  " mouse support
if !has('nvim')              " modern SGR mouse codes carry scroll-wheel through tmux
    set ttymouse=sgr
endif

" ── Files & persistence ───────────────────────────────────────────────────────
set noswapfile               " no .swp clutter in containers
set nobackup
set undofile                 " persistent undo
set undodir=~/.vim/undo
silent !mkdir -p ~/.vim/undo

" ── Clipboard ─────────────────────────────────────────────────────────────────
" Use system clipboard when available (e.g. clipboard forwarding in dev containers)
if has('clipboard')
    set clipboard=unnamedplus
endif

" Forward normal Vim yanks to the host clipboard even when Vim was built
" without +clipboard. aibox-copy uses tmux load-buffer -w and OSC52 fallback.
function! s:AiboxCopyRegister() abort
    if executable('aibox-copy')
        let l:register = empty(v:register) ? '"' : v:register
        call system('aibox-copy', getreg(l:register))
    endif
endfunction

" ── Key mappings ──────────────────────────────────────────────────────────────
let mapleader=" "            " Space as leader

xnoremap <silent> y y:<C-u>call <SID>AiboxCopyRegister()<CR>
nnoremap <silent> yy yy:call <SID>AiboxCopyRegister()<CR>
nnoremap <silent> Y Y:call <SID>AiboxCopyRegister()<CR>
xnoremap <silent> <leader>y y:<C-u>call <SID>AiboxCopyRegister()<CR>
nnoremap <silent> <leader>Y yy:call <SID>AiboxCopyRegister()<CR>

" Word movement across tmux/devcontainer terminals.
"
" Most terminals send Alt+x as raw `ESC + x` bytes, NOT as the synthetic
" <A-x>/<M-x> Vim keycode. Without explicit byte-sequence registration,
" Vim sees the bare ESC, exits INSERT mode, then runs `x` as a normal
" command — so Alt+Left mis-fires as "leave insert, jump back" instead
" of "jump back, stay in insert". The `set <M-x>=^[x` block below tells
" Vim to coalesce those bytes into a single key event, and
" ttimeoutlen=50 resolves the sequence promptly.
set ttimeout
set ttimeoutlen=100
if !has('gui_running')
  " Register alt+letter byte sequences so terminals that send ESC+letter
  " get coalesced into <M-letter>. We intentionally SKIP punctuation
  " (`:` `,` `;` `.` `/`) — registering `<M-:>` would consume the colon
  " that follows a normal-mode Escape, breaking the `Esc:q` quit
  " sequence and any other ad-hoc `Esc` → `:` command-line entry.
  let s:alt_alpha = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  for s:c in split(s:alt_alpha, '\zs')
    execute "set <M-" . s:c . ">=\<Esc>" . s:c
  endfor
  unlet! s:alt_alpha s:c
  " Alt+arrow / Shift-Alt+arrow: vim's `set <A-Left>=...` syntax was
  " removed in 9.x (E518: Unknown option). Modern vim auto-recognises
  " CSI 1;3D etc. as <A-Left> when TERM=xterm-* and the corresponding
  " keycode lookup runs. Terminals that send ESC+b for Alt+b are
  " already covered by the per-letter <M-x>=ESC-x table above.
endif

" <A-Left>/<A-Right> covers CSI Meta-arrow encodings; <M-b>/<M-f>
" covers macOS/WezTerm-style Option-left/right profiles that send Esc-b/Esc-f.
inoremap <A-Left>  <C-o>b
inoremap <A-Right> <C-o>e<Right>
nnoremap <A-Left>  b
nnoremap <A-Right> e
vnoremap <A-Left>  b
vnoremap <A-Right> e
onoremap <A-Left>  b
onoremap <A-Right> e
cnoremap <A-Left>  <C-Left>
cnoremap <A-Right> <C-Right>
inoremap <M-b>     <C-o>b
inoremap <M-f>     <C-o>e<Right>
nnoremap <M-b>     b
nnoremap <M-f>     e
vnoremap <M-b>     b
vnoremap <M-f>     e
onoremap <M-b>     b
onoremap <M-f>     e
cnoremap <M-b>     <C-Left>
cnoremap <M-f>     <C-Right>

" Shift-Alt+Left / Shift-Alt+Right — extend selection by one word.
" In Vim there is no "select while in insert mode"; selection lives in
" Visual mode. INSERT-mode shift-alt-arrow leaves INSERT and enters
" Visual with the cursor moved by one word. Uppercase <M-B>/<M-F>
" covers terminals that send ESC+shift-b/f instead of CSI 1;4 D/C.
inoremap <S-A-Left>  <Esc>vb
inoremap <S-A-Right> <Esc>ve
nnoremap <S-A-Left>  vb
nnoremap <S-A-Right> ve
vnoremap <S-A-Left>  b
vnoremap <S-A-Right> e
inoremap <M-B>       <Esc>vb
inoremap <M-F>       <Esc>ve
nnoremap <M-B>       vb
nnoremap <M-F>       ve
vnoremap <M-B>       b
vnoremap <M-F>       e

" Quick save / quit
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>x :x<CR>

" Buffer navigation
nnoremap <leader>n :bnext<CR>
nnoremap <leader>p :bprev<CR>
nnoremap <leader>l :ls<CR>

" Split navigation (no Ctrl-W prefix gymnastics)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Open netrw file explorer
nnoremap <leader>e :Explore<CR>

" Strip trailing whitespace on save
autocmd BufWritePre * :%s/\s\+$//e
autocmd VimEnter * redraw!

" ── Netrw (built-in file browser) ────────────────────────────────────────────
let g:netrw_banner=0         " no banner
let g:netrw_liststyle=3      " tree view
let g:netrw_browse_split=4   " open in previous window
let g:netrw_winsize=25       " 25% width

" ── Status line (lightweight, no plugin needed) ───────────────────────────────
set statusline=
set statusline+=\ %f                     " file path
set statusline+=\ %m%r%h%w              " flags: modified, readonly, etc.
set statusline+=%=                       " right align
set statusline+=\ %y                     " file type
set statusline+=\ [%{&ff}]              " file format
set statusline+=\ %l/%L:%c\             " line/total:column
